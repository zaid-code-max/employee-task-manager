flowchart TB

    subgraph Local["Existing Local Room Task Flow"]
        direction TB
        LocalScreen["TaskDetailsActivity<br/>Local Task Section"]
        LocalVM["TaskViewModel<br/>allTasks / filteredTasks"]
        LocalRepo["TaskRepository"]
        DAO["TaskDao"]
        DB[("AppDatabase<br/>Room Database")]
        Entity["TaskEntity"]

        LocalScreen -->|"Collects local StateFlows"| LocalVM
        LocalVM -->|"Observes repository.allTasks"| LocalRepo
        LocalRepo -->|"getAllTasks()"| DAO
        DAO -->|"Room query"| DB
        DB -->|"Stored task records"| DAO
        DAO -->|"Flow<List<TaskEntity>>"| LocalRepo

        Entity --- DB
    end

    subgraph Remote["Implemented Remote REST API Task Retrieval"]
        direction TB

        Screen["TaskDetailsActivity<br/>API Section"]
        VM["TaskViewModel<br/>apiTaskState: StateFlow"]
        Repo["TaskRepository<br/>fetchApiTasks()"]
        Client["TaskApiClient<br/>HttpURLConnection"]
        API["JSONPlaceholder REST API<br/>GET /todos"]
        DTO["ApiTaskDto<br/>userId, id, title, completed"]
        Adapter["ApiTaskAdapter"]
        List["recyclerViewApiTasks"]
        States["ProgressBar / Status Text / Retry Button"]

        Screen -->|"loadApiTasks() at onCreate"| VM
        Screen -->|"Retry: forceRefresh = true"| VM

        VM -->|"fetchApiTasks()"| Repo
        Repo -->|"fetchTasks()"| Client
        Client -->|"HTTP GET<br/>https://jsonplaceholder.typicode.com/todos"| API

        API -->|"HTTP status and response body"| Client
        Client -->|"Direct JSON parsing<br/>JSONArray / JSONObject"| DTO
        Client -->|"Result<List<ApiTaskDto>>"| Repo
        Repo -->|"Returns API result"| VM
        VM -->|"apiTaskState"| Screen

        Screen -->|"Success: submitList(tasks)"| Adapter
        Adapter -->|"Binds title, status, API ID and user ID"| List
        VM -->|"Loading / Empty / Error / Success"| States
    end

    NoteAPI["HTTP 204 and empty JSON array produce Empty state.<br/>Non-2xx responses and parsing or network failures produce Error state."]
    NoteStorage["Remote API records remain separate from Room.<br/>No Room persistence, caching, merging or synchronization implemented."]
    NoteParser["JSON is parsed directly into ApiTaskDto.<br/>No separate ApiTaskMapper implementation."]

    Client --- NoteAPI
    Repo --- NoteStorage
    Client --- NoteParser
