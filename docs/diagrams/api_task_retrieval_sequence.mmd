sequenceDiagram
    autonumber
    actor User
    participant Activity as TaskDetailsActivity
    participant VM as TaskViewModel
    participant Repo as TaskRepository
    participant Client as TaskApiClient
    participant API as JSONPlaceholder REST API
    participant DTO as ApiTaskDto
    participant Adapter as ApiTaskAdapter

    User->>Activity: Open TaskDetailsActivity
    Activity->>VM: loadApiTasks()
    VM->>VM: Check current API state
    VM->>VM: Set Loading
    Activity->>VM: Collect apiTaskState
    VM-->>Activity: Loading state
    Activity->>Activity: Show ProgressBar and loading message

    VM->>Repo: fetchApiTasks()
    Repo->>Client: fetchTasks()
    Client->>API: GET /todos

    alt HTTP 204 No Content
        API-->>Client: HTTP 204
        Client-->>Repo: Result.success(emptyList())
        Repo-->>VM: Successful empty result
        VM->>VM: Set Empty
        VM-->>Activity: Empty state
        Activity->>Activity: Show empty message and Retry
        Activity->>Adapter: submitList(emptyList())
        Activity->>Activity: Hide API RecyclerView

    else HTTP 2xx with nonblank response body
        API-->>Client: JSON array response
        Client->>Client: Parse JSONArray and required fields
        Client->>DTO: Create ApiTaskDto records
        Client-->>Repo: Result.success(List<ApiTaskDto>)
        Repo-->>VM: Successful API result

        alt API task list contains records
            VM->>VM: Set Success(tasks)
            VM-->>Activity: Success state
            Activity->>Activity: Hide ProgressBar and Retry
            Activity->>Adapter: submitList(tasks)
            Adapter->>Activity: Render title, status, ID and user ID
            Activity->>Activity: Show API RecyclerView

        else API returns empty JSON array
            VM->>VM: Set Empty
            VM-->>Activity: Empty state
            Activity->>Activity: Show empty message and Retry
            Activity->>Adapter: submitList(emptyList())
            Activity->>Activity: Hide API RecyclerView
        end

    else Non-2xx HTTP response
        API-->>Client: HTTP error response
        Client->>Client: Read error body
        Client-->>Repo: Result.failure(ApiHttpException)
        Repo-->>VM: Failure
        VM->>VM: Set Error(message)
        VM-->>Activity: Error state
        Activity->>Activity: Show error message and Retry
        Activity->>Activity: Hide API RecyclerView

    else Network, timeout, blank body or JSON parsing failure
        Client->>Client: Catch exception
        Client-->>Repo: Result.failure(exception)
        Repo-->>VM: Failure
        VM->>VM: Set Error(message)
        VM-->>Activity: Error state
        Activity->>Activity: Show error message and Retry
        Activity->>Activity: Hide API RecyclerView
    end

    opt User selects Retry
        User->>Activity: Click Retry button
        Activity->>VM: loadApiTasks(forceRefresh = true)
        VM->>VM: Set Loading
        VM->>Repo: fetchApiTasks()
        Repo->>Client: fetchTasks()
        Client->>API: Repeat GET /todos
    end

    Note over Repo,Activity: Remote API tasks are independent of local Room records.
    Note over Client,VM: CancellationException is rethrown rather than converted into an Error state.
